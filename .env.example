NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=

# Payme Merchant API (server-side only). Enable only after the callback URL is registered in Payme Merchant Cabinet.
PAYME_ENABLED=false
# Enter the merchant ID and secret key in Vercel Environment Variables; never expose the key with NEXT_PUBLIC_.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# Payme Merchant Cabinet callback must be registered manually:
# https://cardrive.uz/api/payments/payme/callback
# Optional customer return URL after checkout:
PAYME_RESPONSE_URL=https://cardrive.uz/account/monetization?payment=payme

# Google Play reviewer test account (server-side only)
GOOGLE_PLAY_TEST_PHONE=+998900000000
GOOGLE_PLAY_TEST_OTP=000000

# Click Shop API (server-side only). Keep disabled until Click merchant credentials and callback URL are verified.
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
