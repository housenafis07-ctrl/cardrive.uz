NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=

# Payme Merchant API (server-side only). Keep both values empty until Payme issues/approves credentials.
# Enter the merchant ID and secret key in Vercel Environment Variables; never expose the key with NEXT_PUBLIC_.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# Optional overrides; defaults use the Cardrive site URL and these paths.
PAYME_SERVER_CALLBACK_URL=https://cardrive.uz/api/payments/payme/callback
PAYME_RESPONSE_URL=https://cardrive.uz/account/monetization

# Google Play reviewer test account (server-side only)
GOOGLE_PLAY_TEST_PHONE=+998900000000
GOOGLE_PLAY_TEST_OTP=000000

# Click Shop API (server-side only). Keep disabled until Click merchant credentials and callback URL are verified.
CLICK_ENABLED=false
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
